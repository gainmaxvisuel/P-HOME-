<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Événements - P HOME</title>

  <style>
    :root{
      --bg:#0d1117;
      --surface:#151b23;
      --surface2:#10151c;
      --border:#2a323d;
      --blue:#3b8cff;
      --green:#3ddc84;
      --red:#ff5c67;
      --text:#f5f7fa;
      --muted:#8d98a7;
    }

    *{
      box-sizing:border-box;
      margin:0;
      padding:0;
    }

    body{
      background:var(--bg);
      color:var(--text);
      font-family:Arial,Helvetica,sans-serif;
      min-height:100vh;
    }

    .page{
      width:100%;
      max-width:560px;
      margin:auto;
      padding-bottom:40px;
    }

    header{
      height:68px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding:0 18px;
      border-bottom:1px solid var(--border);
      background:var(--bg);
      position:sticky;
      top:0;
      z-index:20;
    }

    .header-left{
      display:flex;
      align-items:center;
      gap:12px;
    }

    .back{
      width:38px;
      height:38px;
      border-radius:50%;
      border:1px solid var(--border);
      background:var(--surface);
      color:white;
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:21px;
      cursor:pointer;
    }

    .title{
      font-size:19px;
      font-weight:700;
    }

    .logo{
      width:38px;
      height:38px;
      object-fit:contain;
      border-radius:10px;
    }

    main{
      padding:18px 14px;
    }

    .intro{
      margin-bottom:18px;
    }

    .intro h1{
      font-size:23px;
      margin-bottom:7px;
    }

    .intro p{
      color:var(--muted);
      font-size:13px;
      line-height:1.6;
    }

    .card{
      background:var(--surface);
      border:1px solid var(--border);
      border-radius:17px;
      padding:16px;
      margin-bottom:16px;
    }

    .card-title{
      font-size:16px;
      font-weight:700;
      margin-bottom:6px;
    }

    .card-subtitle{
      color:var(--muted);
      font-size:12px;
      line-height:1.5;
      margin-bottom:15px;
    }

    .field{
      margin-bottom:13px;
    }

    label{
      display:block;
      font-size:12px;
      color:#aeb7c4;
      margin-bottom:7px;
    }

    select,
    textarea,
    input[type="file"]{
      width:100%;
      border:1px solid var(--border);
      background:var(--surface2);
      color:white;
      border-radius:11px;
      padding:12px;
      font-size:13px;
      outline:none;
    }

    select:focus,
    textarea:focus{
      border-color:var(--blue);
    }

    textarea{
      min-height:90px;
      resize:vertical;
    }

    input[type="file"]{
      padding:9px;
    }

    input[type="file"]::file-selector-button{
      border:0;
      background:#202934;
      color:white;
      border-radius:8px;
      padding:8px 10px;
      margin-right:8px;
      cursor:pointer;
    }

    .file-help{
      color:var(--muted);
      font-size:11px;
      margin-top:5px;
      line-height:1.4;
    }

    .submit-btn{
      width:100%;
      border:0;
      border-radius:12px;
      padding:13px;
      background:var(--blue);
      color:white;
      font-size:14px;
      font-weight:700;
      cursor:pointer;
    }

    .submit-btn:disabled{
      opacity:.55;
      cursor:not-allowed;
    }

    .message{
      display:none;
      padding:11px 12px;
      border-radius:10px;
      margin-bottom:13px;
      font-size:12px;
      line-height:1.5;
    }

    .message.success{
      display:block;
      background:rgba(61,220,132,.10);
      border:1px solid rgba(61,220,132,.25);
      color:var(--green);
    }

    .message.error{
      display:block;
      background:rgba(255,92,103,.10);
      border:1px solid rgba(255,92,103,.25);
      color:#ff8991;
    }

    .section-title{
      font-size:17px;
      font-weight:700;
      margin:22px 2px 11px;
    }

    .loading{
      text-align:center;
      padding:25px 10px;
      color:var(--muted);
      font-size:13px;
    }

    .empty{
      background:var(--surface);
      border:1px solid var(--border);
      border-radius:15px;
      padding:22px 15px;
      text-align:center;
      color:var(--muted);
      font-size:13px;
      line-height:1.6;
    }

    .event{
      background:var(--surface);
      border:1px solid var(--border);
      border-radius:16px;
      overflow:hidden;
      margin-bottom:13px;
    }

    .event-body{
      padding:14px;
    }

    .event-top{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      margin-bottom:11px;
    }

    .event-user{
      display:flex;
      align-items:center;
      gap:9px;
      min-width:0;
    }

    .avatar{
      width:38px;
      height:38px;
      border-radius:50%;
      background:#202934;
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:15px;
      font-weight:700;
      color:#dbe3ec;
      flex:none;
    }

    .phone{
      font-size:13px;
      font-weight:700;
    }

    .operator{
      color:var(--muted);
      font-size:11px;
      margin-top:3px;
    }

    .status{
      padding:5px 8px;
      border-radius:20px;
      font-size:10px;
      white-space:nowrap;
      background:rgba(61,220,132,.10);
      color:var(--green);
      border:1px solid rgba(61,220,132,.20);
    }

    .status.pending{
      background:rgba(59,140,255,.10);
      color:#76adff;
      border-color:rgba(59,140,255,.20);
    }

    .status.rejected{
      background:rgba(255,92,103,.10);
      color:#ff8991;
      border-color:rgba(255,92,103,.20);
    }

    .amount{
      font-size:19px;
      font-weight:800;
      margin-bottom:3px;
    }

    .amount-label{
      color:var(--muted);
      font-size:11px;
    }

    .description{
      color:#b7c0cc;
      font-size:12px;
      line-height:1.5;
      margin-top:12px;
      padding-top:11px;
      border-top:1px solid var(--border);
    }

    .proof-image{
      width:100%;
      max-height:360px;
      object-fit:cover;
      display:block;
      background:#080b0f;
      border-top:1px solid var(--border);
    }

    .date{
      color:var(--muted);
      font-size:10px;
      margin-top:11px;
    }

    .withdrawal-option{
      display:flex;
      justify-content:space-between;
      align-items:center;
    }

    .footer-note{
      text-align:center;
      color:#596473;
      font-size:10px;
      line-height:1.5;
      margin:25px 10px 5px;
    }

    .hidden{
      display:none!important;
    }
  </style>
</head>

<body>

<div class="page">

  <header>
    <div class="header-left">
      <button class="back" onclick="history.back()" aria-label="Retour">
        ‹
      </button>

      <div class="title">Événements</div>
    </div>

    <img src="logoreg.png" class="logo" alt="P HOME">
  </header>

  <main>

    <div class="intro">
      <h1>Événements</h1>
      <p>
        Retrouvez ici les preuves de retrait publiées par les membres ainsi
        que l'espace permettant d'envoyer votre propre preuve de retrait.
      </p>
    </div>

    <!-- ENVOI D'UNE PREUVE -->
    <section class="card">

      <div class="card-title">
        Publier une preuve de retrait
      </div>

      <div class="card-subtitle">
        Sélectionnez votre retrait puis envoyez les deux images demandées.
        Les preuves envoyées sont enregistrées dans la base de données.
      </div>

      <div id="formMessage" class="message"></div>

      <div id="uploadArea">

        <div class="field">
          <label for="withdrawalSelect">
            Retrait concerné
          </label>

          <select id="withdrawalSelect">
            <option value="">
              Chargement des retraits...
            </option>
          </select>
        </div>

        <div class="field">
          <label for="requestImage">
            Preuve de la demande de retrait
          </label>

          <input
            type="file"
            id="requestImage"
            accept="image/jpeg,image/png,image/webp"
          >

          <div class="file-help">
            JPG, PNG ou WebP — 5 Mo maximum.
          </div>
        </div>

        <div class="field">
          <label for="receivedImage">
            Preuve de réception du retrait
          </label>

          <input
            type="file"
            id="receivedImage"
            accept="image/jpeg,image/png,image/webp"
          >

          <div class="file-help">
            Cette image pourra apparaître dans les événements publics.
          </div>
        </div>

        <div class="field">
          <label for="description">
            Description
          </label>

          <textarea
            id="description"
            maxlength="1000"
            placeholder="Ajoutez une courte description..."
          ></textarea>
        </div>

        <button
          class="submit-btn"
          id="submitBtn"
          onclick="submitProof()"
        >
          Publier la preuve
        </button>

      </div>

      <div id="noWithdrawal" class="empty hidden">
        Aucun retrait disponible pour l'envoi d'une nouvelle preuve.
      </div>

    </section>


    <!-- PREUVES PUBLIÉES -->
    <div class="section-title">
      Dernières preuves de retrait
    </div>

    <div id="eventsLoading" class="loading">
      Chargement des événements...
    </div>

    <div id="eventsList"></div>

    <div id="eventsEmpty" class="empty hidden">
      Aucune preuve de retrait n'a encore été publiée.
    </div>

    <div class="footer-note">
      Les numéros de téléphone des autres membres sont volontairement
      masqués. Seuls les quatre derniers chiffres sont affichés.
    </div>

  </main>

</div>


<script>
  const EVENTS_URL =
    "https://rdnrmufucbhsvgpnqodh.supabase.co/functions/v1/p-home-events";

  const PROOF_URL =
    "https://rdnrmufucbhsvgpnqodh.supabase.co/functions/v1/submit-withdrawal-proof";

  const token =
    sessionStorage.getItem("phome_session_token");

  if (!token) {
    window.location.href = "login.html";
  }


  function showMessage(text, type){
    const box = document.getElementById("formMessage");

    box.textContent = text;
    box.className = "message " + type;
  }


  function formatAmount(value){
    if(value === null || value === undefined){
      return "—";
    }

    return Number(value).toLocaleString("fr-FR") + " XOF";
  }


  function formatDate(value){
    if(!value){
      return "";
    }

    const date = new Date(value);

    return date.toLocaleDateString("fr-FR", {
      day:"2-digit",
      month:"2-digit",
      year:"numeric"
    }) + " à " + date.toLocaleTimeString("fr-FR", {
      hour:"2-digit",
      minute:"2-digit"
    });
  }


  function statusLabel(status){

    if(status === "approved"){
      return {
        text:"Retrait validé",
        className:""
      };
    }

    if(status === "processing"){
      return {
        text:"En traitement",
        className:"pending"
      };
    }

    if(status === "checked"){
      return {
        text:"Vérifié",
        className:"pending"
      };
    }

    if(status === "rejected"){
      return {
        text:"Rejetée",
        className:"rejected"
      };
    }

    return {
      text:"En vérification",
      className:"pending"
    };
  }


  function renderWithdrawals(items){

    const select =
      document.getElementById("withdrawalSelect");

    const uploadArea =
      document.getElementById("uploadArea");

    const noWithdrawal =
      document.getElementById("noWithdrawal");

    select.innerHTML = "";

    if(!items || items.length === 0){

      uploadArea.classList.add("hidden");
      noWithdrawal.classList.remove("hidden");

      return;
    }

    uploadArea.classList.remove("hidden");
    noWithdrawal.classList.add("hidden");

    const first =
      document.createElement("option");

    first.value = "";
    first.textContent =
      "Sélectionner un retrait";

    select.appendChild(first);

    items.forEach(item => {

      const option =
        document.createElement("option");

      option.value = item.id;

      option.textContent =
        formatAmount(item.amount) +
        " — " +
        formatDate(item.created_at);

      select.appendChild(option);

    });
  }


  function renderEvents(items){

    const loading =
      document.getElementById("eventsLoading");

    const list =
      document.getElementById("eventsList");

    const empty =
      document.getElementById("eventsEmpty");

    loading.classList.add("hidden");

    list.innerHTML = "";

    if(!items || items.length === 0){

      empty.classList.remove("hidden");

      return;
    }

    empty.classList.add("hidden");

    items.forEach(item => {

      const status =
        statusLabel(item.proof_status);

      const article =
        document.createElement("article");

      article.className = "event";

      const image =
        item.image_url
          ? `
            <img
              src="${escapeHtml(item.image_url)}"
              class="proof-image"
              alt="Preuve de retrait"
              loading="lazy"
            >
          `
          : "";

      const description =
        item.description
          ? `
            <div class="description">
              ${escapeHtml(item.description)}
            </div>
          `
          : "";

      article.innerHTML = `

        <div class="event-body">

          <div class="event-top">

            <div class="event-user">

              <div class="avatar">
                P
              </div>

              <div>
                <div class="phone">
                  ${escapeHtml(item.phone || "••••")}
                </div>

                <div class="operator">
                  ${escapeHtml(item.operator || "Retrait")}
                </div>
              </div>

            </div>

            <div class="status ${status.className}">
              ${status.text}
            </div>

          </div>

          <div class="amount">
            ${formatAmount(item.amount)}
          </div>

          <div class="amount-label">
            Preuve de retrait publiée
          </div>

          ${description}

          <div class="date">
            ${formatDate(item.created_at)}
          </div>

        </div>

        ${image}

      `;

      list.appendChild(article);
    });
  }


  function escapeHtml(value){

    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }


  async function loadEvents(){

    try{

      const response =
        await fetch(EVENTS_URL, {
          method:"POST",

          headers:{
            "Content-Type":"application/json"
          },

          body:JSON.stringify({
            token:token
          })
        });

      const data =
        await response.json();

      if(!response.ok || !data.success){

        throw new Error(
          data.message ||
          "Impossible de charger les événements."
        );
      }

      renderWithdrawals(
        data.my_withdrawals || []
      );

      renderEvents(
        data.proofs || []
      );

    }catch(error){

      document.getElementById(
        "eventsLoading"
      ).textContent =
        error.message ||
        "Erreur lors du chargement.";

      showMessage(
        error.message ||
        "Erreur lors du chargement.",
        "error"
      );
    }
  }


  async function submitProof(){

    const withdrawalId =
      document.getElementById(
        "withdrawalSelect"
      ).value;

    const requestFile =
      document.getElementById(
        "requestImage"
      ).files[0];

    const receivedFile =
      document.getElementById(
        "receivedImage"
      ).files[0];

    const description =
      document.getElementById(
        "description"
      ).value.trim();

    const button =
      document.getElementById(
        "submitBtn"
      );

    if(!withdrawalId){

      showMessage(
        "Sélectionnez le retrait concerné.",
        "error"
      );

      return;
    }

    if(!requestFile){

      showMessage(
        "Ajoutez la preuve de la demande de retrait.",
        "error"
      );

      return;
    }

    if(!receivedFile){

      showMessage(
        "Ajoutez la preuve de réception du retrait.",
        "error"
      );

      return;
    }

    if(!description){

      showMessage(
        "Ajoutez une description.",
        "error"
      );

      return;
    }

    if(requestFile.size > 5 * 1024 * 1024 ||
       receivedFile.size > 5 * 1024 * 1024){

      showMessage(
        "Chaque image doit faire 5 Mo maximum.",
        "error"
      );

      return;
    }

    button.disabled = true;
    button.textContent = "Envoi en cours...";

    try{

      const form =
        new FormData();

      form.append(
        "withdrawal_id",
        withdrawalId
      );

      form.append(
        "request_image",
        requestFile
      );

      form.append(
        "received_image",
        receivedFile
      );

      form.append(
        "description",
        description
      );

      const response =
        await fetch(PROOF_URL, {

          method:"POST",

          headers:{
            "Authorization":
              "Bearer " + token
          },

          body:form
        });

      const data =
        await response.json();

      if(!response.ok || !data.success){

        throw new Error(
          data.message ||
          "Impossible d'envoyer la preuve."
        );
      }

      showMessage(
        "Votre preuve de retrait a été envoyée avec succès.",
        "success"
      );

      document.getElementById(
        "requestImage"
      ).value = "";

      document.getElementById(
        "receivedImage"
      ).value = "";

      document.getElementById(
        "description"
      ).value = "";

      document.getElementById(
        "withdrawalSelect"
      ).value = "";

      await loadEvents();

    }catch(error){

      showMessage(
        error.message ||
        "Erreur lors de l'envoi.",
        "error"
      );

    }finally{

      button.disabled = false;
      button.textContent =
        "Publier la preuve";
    }
  }


  loadEvents();

</script>

</body>
</html>
